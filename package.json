{
  "name": "homebridge-dirigera",
  "version": "1.0.0",
  "author": "uboness; maintained by ZeliardM",
  "type": "commonjs",
  "displayName": "Homebridge DIRIGERA",
  "description": "IKEA DIRIGERA Homebridge Plugin",
  "license": "Apache-2.0",
  "keywords": [
    "homebridge-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZeliardM/homebridge-dirigera.git"
  },
  "bugs": {
    "url": "https://github.com/ZeliardM/homebridge-dirigera/issues"
  },
  "homepage": "https://github.com/ZeliardM/homebridge-dirigera#readme",
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "homebridge": "^1.6.0 || ^2.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "tsconfig.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "dist",
    "homebridge-ui",
    "config.schema.json"
  ],
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "rimraf ./dist && tsc",
    "watch": "npm run clean && tsc -w",
    "prepublishOnly": "npm run build",
    "release:bump": "npm run build && commit-and-tag-version",
    "release:bump-minor": "commit-and-tag-version --release-as minor",
    "release:bump-major": "commit-and-tag-version --release-as major",
    "release:postbump": "npm run release:push && npm run release:publish",
    "release:push": "git push --follow-tags",
    "release:publish": "npm publish --access public",
    "release": "npm run release:bump && npm run release:postbump",
    "release-minor": "npm run release:bump-minor && npm run release:push && npm run release:publish",
    "release-major": "npm run release:bump-major && npm run release:push && npm run release:publish"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.3",
    "dirigera": "^1.8.0",
    "got": "^15.0.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "commit-and-tag-version": "^12.7.3",
    "homebridge": "^2.0.2",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "brace-expansion": "^1.1.14",
    "handlebars": "^4.7.9",
    "minimatch": "^3.1.4",
    "node-persist": "^4.0.4"
  }
}
